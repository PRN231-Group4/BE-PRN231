@model IEnumerable<View_Wine.Models.WineCheckModal>

@{
    ViewData["Title"] = "Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #343a40;
            text-align: center;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background-color: #fff;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

            .table th, .table td {
                padding: 12px;
                text-align: left;
                border-bottom: 1px solid #dee2e6;
            }

            .table th {
                background-color: #007bff;
                color: white;
            }

        .btn {
            padding: 10px 15px;
            margin: 5px;
            border: none;
            border-radius: 4px;
            color: white;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-update-success {
            background-color: #28a745; /* Green for success */
        }

        .btn-update-failed {
            background-color: #dc3545; /* Red for failed */
        }

        .image-cell img {
            max-width: 100px; /* Set a max width for images */
        }
    </style>
</head>
<body>

    <h1>Wine Export Detail</h1>

    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().CheckId)</th>
                <th>@Html.DisplayNameFor(model => model.First().RequestId)</th>
                <th>@Html.DisplayNameFor(model => model.First().InspectorId)</th>
                <th>@Html.DisplayNameFor(model => model.First().wineName)</th>
                <th>@Html.DisplayNameFor(model => model.First().Quantity)</th>
                <th>@Html.DisplayNameFor(model => model.First().Description)</th>
                <th>@Html.DisplayNameFor(model => model.First().Status)</th>
                <th>@Html.DisplayNameFor(model => model.First().CheckDate)</th>
                <th>@Html.DisplayNameFor(model => model.First().ImageUrl)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.CheckId)</td>
                    <td>@Html.DisplayFor(modelItem => item.RequestId)</td>
                    <td>@Html.DisplayFor(modelItem => item.InspectorId)</td>
                    <td>@Html.DisplayFor(modelItem => item.wineName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                    <td>@Html.DisplayFor(modelItem => item.CheckDate)</td>
                    <td class="image-cell">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="Wine Image" />
                        }
                    </td>
                    <td>

                        <!-- Form for updating status to success -->
                        <form asp-action="UpdateStatusSuccessDetailExport" method="post" style="display:inline;">
                            <input type="hidden" name="CheckId" value="@item.CheckId" />
                            <button type="submit" class="btn btn-update-success"><i class="fas fa-check"></i> Thành Công</button>
                        </form>

                        <!-- Form for updating status to failed -->
                        <form asp-action="UpdateStatusFailedDetailExport" method="post" style="display:inline;">
                            <input type="hidden" name="CheckId" value="@item.CheckId" />
                            <button type="submit" class="btn btn-update-failed"><i class="fas fa-times"></i> Thất Bại</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>