@model WineBatchModal

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Wine Batch</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="_method" value="PUT" /> <!-- Chỉ định PUT -->

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="hidden" asp-for="RequestId" class="form-control" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="BatchId" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="WineId" class="control-label"></label>
                <select asp-for="WineId" class="form-control" asp-items="ViewBag.WineList"></select>
                <span asp-validation-for="WineId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="@(new SelectList(new List<SelectListItem>
    {
       new SelectListItem { Value = "In Stock", Text = "In Stock" },
        new SelectListItem { Value = "Out Of Stock", Text = "Out Of Stock" },
    }, "Value", "Text"))">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImportDate" class="control-label"></label>
                <input asp-for="ImportDate" class="form-control" />
                <span asp-validation-for="ImportDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BatchNumber" class="control-label"></label>
                <input asp-for="BatchNumber" class="form-control" />
                <span asp-validation-for="BatchNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProductionYear" class="control-label"></label>
                <input asp-for="ProductionYear" class="form-control" />
                <span asp-validation-for="ProductionYear" class="text-danger"></span>

            </div>


            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
