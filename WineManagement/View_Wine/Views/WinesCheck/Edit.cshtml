@model WineCheckModal

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Wine Request</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" name="_method" value="PUT" /> <!-- Chỉ định PUT -->

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="hidden" asp-for="CheckId" class="form-control" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="RequestId" class="form-control" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="InspectorId" class="form-control" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="WineId" class="form-control" />
            </div>

            

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="@(new SelectList(new List<SelectListItem>
    {
        new SelectListItem { Value = "Chưa xử lý", Text = "Chưa xử lý" },
        new SelectListItem { Value = "Đang xử lý", Text = "Đang xử lý" },
        new SelectListItem { Value = "Đã xử lý", Text = "Đã xử lý" }
    }, "Value", "Text"))">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CheckDate" class="control-label"></label>
                <input asp-for="CheckDate" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input asp-for="ImageUrl" class="form-control" type="file" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
            

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
