@using BusinessLayer.Modal.Request

@model LoginModel

@section Styles {
    <link href="css/site.css" rel="stylesheet" />
}
@section Scripts{
    <script src="controller/account.js" asp-append-version="true"></script>
}

 <div class="login_page">
    <div class="login-container">
        <form class="login-form" id="loginForm">
            <h2>Đăng Nhập</h2>
            <div class="form-group">
                <label for="username">Tên Đăng Nhập</label>
                <input asp-for="@Model.Username" type="text" id="username" name="username" required>
            </div>
            <div class="form-group">
                <label for="password">Mật Khẩu</label>
                <input asp-for="@Model.Password" type="password" id="password" name="password" required>
            </div>
            <button type="submit">Đăng Nhập</button>
        </form>
    </div>
 </div>